<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.team4u</groupId>
        <artifactId>team4u-framework</artifactId>
        <version>1.0.0-SNAPSHOT</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <artifactId>team4u-singleflight-core</artifactId>
    <description>回源合并核心：同 key 唯一执行者的并发控制引擎（WAIT/FAIL_FAST/FALLBACK、errorFallback、key 摘要与协调会话状态机）</description>

    <dependencies>
        <dependency>
            <groupId>com.team4u</groupId>
            <artifactId>team4u-base</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.team4u</groupId>
            <artifactId>team4u-policy</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.team4u</groupId>
            <artifactId>team4u-criterion</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.team4u</groupId>
            <artifactId>team4u-config-core</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.team4u</groupId>
            <artifactId>team4u-kv-core</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.team4u</groupId>
            <artifactId>team4u-kv-lock</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.team4u</groupId>
            <artifactId>team4u-kv-space</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.team4u</groupId>
            <artifactId>team4u-serializer-json</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- durable-schema 豁免：会话信封（SessionEnvelope）与降级转换（FallbackConverter）
             直接依赖 Jackson 树模型构建稳定持久化 schema，不经 provider SPI。
             依据 release gate，singleflight 是 Jackson runtime owner 之一。 -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <dependency>
            <groupId>com.team4u</groupId>
            <artifactId>team4u-serializer-jackson</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.team4u</groupId>
            <artifactId>team4u-config-test</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.team4u</groupId>
            <artifactId>team4u-kv-test</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-simple</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>junit</groupId>
            <artifactId>junit</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <executions>
                    <execution>
                        <id>enforce-singleflight-core-boundary</id>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <bannedDependencies>
                                    <excludes>
                                        <exclude>com.team4u:team4u-proxy:*:*:compile</exclude>
                                        <exclude>com.team4u:team4u-proxy:*:*:runtime</exclude>
                                        <exclude>com.team4u:team4u-proxy-spring:*:*:compile</exclude>
                                        <exclude>com.team4u:team4u-proxy-spring:*:*:runtime</exclude>
                                        <exclude>com.team4u:team4u-serializer-jackson:*:*:compile</exclude>
                                        <exclude>com.team4u:team4u-serializer-jackson:*:*:runtime</exclude>
                                        <exclude>org.springframework*:*:*:*:compile</exclude>
                                        <exclude>org.springframework*:*:*:*:runtime</exclude>
                                        <exclude>net.bytebuddy:*:*:*:compile</exclude>
                                        <exclude>net.bytebuddy:*:*:*:runtime</exclude>
                                    </excludes>
                                    <message>singleflight core bans proxy, Spring, and the serializer provider; its Jackson databind edge is the documented durable-schema exemption.</message>
                                </bannedDependencies>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
