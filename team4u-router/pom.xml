<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.team4u</groupId>
        <artifactId>team4u-framework</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>team4u-router</artifactId>

    <dependencies>
        <dependency>
            <groupId>com.team4u</groupId>
            <artifactId>team4u-serializer-json</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.team4u</groupId>
            <artifactId>team4u-serializer-jackson</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
            <exclusions>
                <exclusion>
                    <groupId>com.team4u</groupId>
                    <artifactId>team4u-config-proxy</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>com.team4u</groupId>
            <artifactId>team4u-base</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.team4u</groupId>
            <artifactId>team4u-config-core</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.team4u</groupId>
            <artifactId>team4u-policy</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.team4u</groupId>
            <artifactId>team4u-criterion</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
        </dependency>
        <dependency>
            <groupId>com.team4u</groupId>
            <artifactId>team4u-config-test</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
            <exclusions>
                <exclusion>
                    <groupId>com.team4u</groupId>
                    <artifactId>team4u-config-proxy</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <dependency>
            <groupId>junit</groupId>
            <artifactId>junit</artifactId>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-simple</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <executions>
                    <execution>
                        <id>enforce-router-core-boundary</id>
                        <goals><goal>enforce</goal></goals>
                        <configuration>
                            <rules>
                                <bannedDependencies>
                                    <excludes>
                                        <exclude>com.team4u:team4u-proxy:*:*:compile</exclude>
                                        <exclude>com.team4u:team4u-proxy:*:*:runtime</exclude>
                                        <exclude>com.team4u:team4u-bean:*:*:compile</exclude>
                                        <exclude>com.team4u:team4u-bean:*:*:runtime</exclude>
                                        <exclude>com.team4u:team4u-router-proxy:*:*:compile</exclude>
                                        <exclude>com.team4u:team4u-router-proxy:*:*:runtime</exclude>
                                        <exclude>com.team4u:team4u-config-proxy:*:*:compile</exclude>
                                        <exclude>com.team4u:team4u-config-proxy:*:*:runtime</exclude>
                                        <exclude>net.bytebuddy:*:*:*:compile</exclude>
                                        <exclude>net.bytebuddy:*:*:*:runtime</exclude>
                                        <exclude>com.team4u:team4u-serializer-jackson:*:*:compile</exclude>
                                        <exclude>com.team4u:team4u-serializer-jackson:*:*:runtime</exclude>
                                        <exclude>com.fasterxml.jackson*:*:*:*:compile</exclude>
                                        <exclude>com.fasterxml.jackson*:*:*:*:runtime</exclude>
                                    </excludes>
                                </bannedDependencies>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>
