<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.team4u</groupId>
        <artifactId>team4u-framework</artifactId>
        <version>1.0.0-SNAPSHOT</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <artifactId>team4u-lease-core</artifactId>

    <dependencies>
        <dependency>
            <groupId>com.team4u</groupId>
            <artifactId>team4u-base</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-simple</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>junit</groupId>
            <artifactId>junit</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <executions>
                    <execution>
                        <id>enforce-lease-core-boundary</id>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <bannedDependencies>
                                    <excludes>
                                        <exclude>com.team4u:team4u-config*:*:*:compile</exclude>
                                        <exclude>com.team4u:team4u-config*:*:*:runtime</exclude>
                                        <exclude>com.team4u:team4u-retry*:*:*:compile</exclude>
                                        <exclude>com.team4u:team4u-retry*:*:*:runtime</exclude>
                                        <exclude>com.team4u:team4u-kv*:*:*:compile</exclude>
                                        <exclude>com.team4u:team4u-kv*:*:*:runtime</exclude>
                                        <exclude>com.team4u:team4u-serializer-jackson:*:*:compile</exclude>
                                        <exclude>com.team4u:team4u-serializer-jackson:*:*:runtime</exclude>
                                        <exclude>com.fasterxml.jackson*:*:*:*:compile</exclude>
                                        <exclude>com.fasterxml.jackson*:*:*:*:runtime</exclude>
                                        <exclude>org.springframework*:*:*:*:compile</exclude>
                                        <exclude>org.springframework*:*:*:*:runtime</exclude>
                                    </excludes>
                                    <message>lease-core must stay independent of Config, Retry, KV, Jackson, and Spring.</message>
                                </bannedDependencies>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
