<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.team4u</groupId>
        <artifactId>team4u-framework</artifactId>
        <version>1.0.0-SNAPSHOT</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <artifactId>team4u-ratelimiter-spring</artifactId>
    <description>限流 Spring 装配：@EnableRateLimit 显式配置（依赖 ratelimiter-proxy、proxy-spring 与 Spring）</description>

    <dependencies>
        <dependency>
            <groupId>com.team4u</groupId>
            <artifactId>team4u-ratelimiter-proxy</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.team4u</groupId>
            <artifactId>team4u-proxy-spring</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-context</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-aop</artifactId>
        </dependency>

        <dependency>
            <groupId>net.bytebuddy</groupId>
            <artifactId>byte-buddy</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.team4u</groupId>
            <artifactId>team4u-serializer-jackson</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.team4u</groupId>
            <artifactId>team4u-config-test</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.team4u</groupId>
            <artifactId>team4u-kv-test</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-test</artifactId>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-simple</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>junit</groupId>
            <artifactId>junit</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <executions>
                    <execution>
                        <id>enforce-ratelimiter-spring-boundary</id>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <bannedDependencies>
                                    <excludes>
                                        <exclude>com.team4u:team4u-serializer-jackson:*:*:compile</exclude>
                                        <exclude>com.team4u:team4u-serializer-jackson:*:*:runtime</exclude>
                                        <exclude>com.fasterxml.jackson*:*:*:*:compile</exclude>
                                        <exclude>com.fasterxml.jackson*:*:*:*:runtime</exclude>
                                        <exclude>org.springframework.boot:*:*:*:compile</exclude>
                                        <exclude>org.springframework.boot:*:*:*:runtime</exclude>
                                    </excludes>
                                    <message>ratelimiter spring adapter is a plain Spring configuration, not a Boot auto-configuration, and must not own the Jackson provider.</message>
                                </bannedDependencies>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
