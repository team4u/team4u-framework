<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <artifactId>team4u-framework</artifactId>
        <groupId>com.team4u</groupId>
        <version>1.0.0-SNAPSHOT</version>
        <relativePath>../../../pom.xml</relativePath>
    </parent>

    <artifactId>team4u-log</artifactId>

    <dependencies>
        <dependency>
            <groupId>com.team4u</groupId>
            <artifactId>team4u-base</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.team4u</groupId>
            <artifactId>team4u-policy</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
        </dependency>
        <dependency>
            <groupId>ch.qos.logback</groupId>
            <artifactId>logback-classic</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>junit</groupId>
            <artifactId>junit</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <executions>
                    <execution>
                        <id>enforce-log-core-boundary</id>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <bannedDependencies>
                                    <excludes>
                                        <exclude>com.fasterxml.jackson*:*:*:*:compile</exclude>
                                        <exclude>com.fasterxml.jackson*:*:*:*:runtime</exclude>
                                        <exclude>org.springframework*:*:*:*:compile</exclude>
                                        <exclude>org.springframework*:*:*:*:runtime</exclude>
                                        <exclude>net.bytebuddy:*:*:*:compile</exclude>
                                        <exclude>net.bytebuddy:*:*:*:runtime</exclude>
                                        <exclude>com.team4u:team4u-mask:*:*:*:compile</exclude>
                                        <exclude>com.team4u:team4u-mask:*:*:*:runtime</exclude>
                                        <exclude>com.team4u:team4u-mask-config:*:*:*:compile</exclude>
                                        <exclude>com.team4u:team4u-mask-config:*:*:*:runtime</exclude>
                                        <exclude>com.team4u:team4u-mask-jackson:*:*:*:compile</exclude>
                                        <exclude>com.team4u:team4u-mask-jackson:*:*:*:runtime</exclude>
                                        <exclude>com.team4u:team4u-config-core:*:*:*:compile</exclude>
                                        <exclude>com.team4u:team4u-config-core:*:*:*:runtime</exclude>
                                        <exclude>com.team4u:team4u-criterion:*:*:*:compile</exclude>
                                        <exclude>com.team4u:team4u-criterion:*:*:*:runtime</exclude>
                                        <exclude>com.team4u:team4u-proxy:*:*:*:compile</exclude>
                                        <exclude>com.team4u:team4u-proxy:*:*:*:runtime</exclude>
                                        <exclude>com.team4u:team4u-serializer-json:*:*:*:compile</exclude>
                                        <exclude>com.team4u:team4u-serializer-json:*:*:*:runtime</exclude>
                                        <exclude>com.team4u:team4u-serializer-jackson:*:*:*:compile</exclude>
                                        <exclude>com.team4u:team4u-serializer-jackson:*:*:*:runtime</exclude>
                                    </excludes>
                                    <message>log core must remain free of governance and provider dependencies.</message>
                                </bannedDependencies>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
