<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.team4u</groupId>
        <artifactId>team4u-framework</artifactId>
        <version>1.0.0-SNAPSHOT</version>
        <relativePath>../../../pom.xml</relativePath>
    </parent>

    <artifactId>team4u-ratelimiter</artifactId>
    <description>限流核心：配置驱动的多算法限流引擎（固定窗口、令牌桶、滑动窗口、历史窗口），基于 KvStore 能力协商与 NamedKvStoreRegistry 多存储分工</description>

    <dependencies>
        <dependency>
            <groupId>com.team4u</groupId>
            <artifactId>team4u-base</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.team4u</groupId>
            <artifactId>team4u-policy</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.team4u</groupId>
            <artifactId>team4u-config</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.team4u</groupId>
            <artifactId>team4u-kv</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.team4u</groupId>
            <artifactId>team4u-kv-space</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.team4u</groupId>
            <artifactId>team4u-serializer-json</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <dependency>
            <groupId>com.team4u</groupId>
            <artifactId>team4u-serializer-jackson</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.team4u</groupId>
            <artifactId>team4u-config-test</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.team4u</groupId>
            <artifactId>team4u-kv-test</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-simple</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-core</artifactId>
        </dependency>
        <dependency>
            <groupId>junit</groupId>
            <artifactId>junit</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <executions>
                    <execution>
                        <id>enforce-ratelimiter-core-boundary</id>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <bannedDependencies>
                                    <excludes>
                                        <exclude>com.team4u:team4u-proxy:*:*:compile</exclude>
                                        <exclude>com.team4u:team4u-proxy:*:*:runtime</exclude>
                                        <exclude>com.team4u:team4u-proxy-spring:*:*:compile</exclude>
                                        <exclude>com.team4u:team4u-proxy-spring:*:*:runtime</exclude>
                                        <exclude>com.team4u:team4u-serializer-jackson:*:*:compile</exclude>
                                        <exclude>com.team4u:team4u-serializer-jackson:*:*:runtime</exclude>
                                        <exclude>com.fasterxml.jackson*:*:*:*:compile</exclude>
                                        <exclude>com.fasterxml.jackson*:*:*:*:runtime</exclude>
                                        <exclude>org.springframework*:*:*:*:compile</exclude>
                                        <exclude>org.springframework*:*:*:*:runtime</exclude>
                                        <exclude>net.bytebuddy:*:*:*:compile</exclude>
                                        <exclude>net.bytebuddy:*:*:*:runtime</exclude>
                                    </excludes>
                                    <message>ratelimiter core must stay free of proxy, Spring, and Jackson provider edges; annotations live in ratelimiter-proxy.</message>
                                </bannedDependencies>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
