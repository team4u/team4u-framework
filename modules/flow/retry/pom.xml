<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.team4u</groupId>
        <artifactId>team4u-framework</artifactId>
        <version>1.0.0-SNAPSHOT</version>
        <relativePath>../../../pom.xml</relativePath>
    </parent>

    <artifactId>team4u-flow-retry</artifactId>
    <description>Flow 重试治理策略适配层：基于 team4u-retry 与 Policy 契约的重试与退避治理策略适配器</description>

    <dependencies>
        <dependency>
            <groupId>com.team4u</groupId>
            <artifactId>team4u-flow</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.team4u</groupId>
            <artifactId>team4u-retry</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- 可选生产依赖：FlowRetryPolicy 反射访问 DynamicRetryPolicyRegistry（存在则启用动态策略解析，缺失则降级命名注册表） -->
        <dependency>
            <groupId>com.team4u</groupId>
            <artifactId>team4u-retry-config</artifactId>
            <version>${project.version}</version>
            <optional>true</optional>
        </dependency>
        <!-- 可选生产依赖：FlowRetryStateMapper 实现 durable 的 StateMapper SPI（无 Spring/Jackson 传递） -->
        <dependency>
            <groupId>com.team4u</groupId>
            <artifactId>team4u-flow-durable</artifactId>
            <version>${project.version}</version>
            <optional>true</optional>
        </dependency>
        <!-- 可选生产依赖：FlowDefinitionExtension 与 PolicyProvider 适配 -->
        <dependency>
            <groupId>com.team4u</groupId>
            <artifactId>team4u-flow-definition</artifactId>
            <version>${project.version}</version>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
        </dependency>

        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <dependency>
            <groupId>com.team4u</groupId>
            <artifactId>team4u-flow-test</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.team4u</groupId>
            <artifactId>team4u-config-test</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <!-- 动态重试策略（team4u-retry-config）解析 JSON 配置所需的运行时 SPI 实现 -->
        <dependency>
            <groupId>com.team4u</groupId>
            <artifactId>team4u-serializer-jackson</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>junit</groupId>
            <artifactId>junit</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-simple</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <executions>
                    <execution>
                        <id>enforce-flow-retry-boundary</id>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <bannedDependencies>
                                    <searchTransitive>false</searchTransitive>
                                    <excludes>
                                        <exclude>org.springframework*:*:*:*:compile</exclude>
                                        <exclude>org.springframework*:*:*:*:runtime</exclude>
                                        <exclude>com.fasterxml.jackson*:*:*:*:compile</exclude>
                                        <exclude>com.fasterxml.jackson*:*:*:*:runtime</exclude>
                                    </excludes>
                                    <message>team4u-flow-retry production code may depend only on team4u-flow and team4u-retry; Spring and Jackson are forbidden as direct production dependencies.</message>
                                </bannedDependencies>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
